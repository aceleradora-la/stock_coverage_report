<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_stock_cover" model="ir.ui.view">
        <field name="name">product.template.form.stock.cover</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='inventory']" position="inside">
                <group string="Stock Coverage" name="stock_cover_group" invisible="not is_storable">
                    <field name="stock_cover_window_days" placeholder="From category"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
